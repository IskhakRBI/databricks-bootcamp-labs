{
  "benchmarks": {
    "questions": [
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  `order_month`,\n",
              "  MEASURE(`revenue`) AS `revenue`\n",
              "FROM bootcamp_dev.dev_rahmani_taoufiq_sales.orders_metrics\n",
              "GROUP BY ALL\n",
              "ORDER BY `order_month` ASC"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bf99e88a14ff8a11accc34350c3a",
        "question": [
          "How did revenue trend by month in 2026?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  COUNT(DISTINCT CASE WHEN dd.is_weekend THEN fo.order_id END) AS weekend_orders,\n",
              "  COUNT(DISTINCT fo.order_id) AS total_orders,\n",
              "  COUNT(DISTINCT CASE WHEN dd.is_weekend THEN fo.order_id END) * 100.0\n",
              "    / COUNT(DISTINCT fo.order_id) AS weekend_share_pct\n",
              "FROM bootcamp_dev.dev_rahmani_taoufiq_sales.fact_orders fo\n",
              "JOIN bootcamp_dev.dev_rahmani_taoufiq_sales.dim_date dd\n",
              "  ON fo.order_date = dd.date"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bf99e86b17669079ca762f03a734",
        "question": [
          "How many orders were placed on weekends, and what share of all orders is that?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  `segment`,\n",
              "  MEASURE(`avg_order_value`) AS `avg_order_value`\n",
              "FROM bootcamp_dev.dev_rahmani_taoufiq_sales.orders_metrics\n",
              "GROUP BY ALL\n",
              "ORDER BY `avg_order_value` DESC"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bf99e84b19ecb64d945858a2dc15",
        "question": [
          "What is the average order value by customer segment?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  dp.product_name,\n",
              "  SUM(fo.amount) AS revenue\n",
              "FROM bootcamp_dev.dev_rahmani_taoufiq_sales.fact_orders fo\n",
              "JOIN bootcamp_dev.dev_rahmani_taoufiq_sales.dim_product dp\n",
              "  ON fo.product_id = dp.product_id\n",
              "GROUP BY dp.product_name\n",
              "ORDER BY revenue DESC\n",
              "LIMIT 5"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bf99e82b1a7c9c5d734960cd3cb9",
        "question": [
          "Which five products generated the most revenue?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  dc.region,\n",
              "  SUM(fo.amount) AS revenue\n",
              "FROM bootcamp_dev.dev_rahmani_taoufiq_sales.fact_orders fo\n",
              "JOIN bootcamp_dev.dev_rahmani_taoufiq_sales.dim_customer dc\n",
              "  ON fo.customer_id = dc.customer_id\n",
              "GROUP BY dc.region\n",
              "ORDER BY revenue DESC"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1bf99e80a17efae3ed5d4c0836b6b",
        "question": [
          "What is total revenue by customer region?"
        ]
      }
    ]
  },
