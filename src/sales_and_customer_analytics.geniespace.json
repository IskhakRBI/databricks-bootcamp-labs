  "instructions": {
    "example_question_sqls": [
      {
        "id": "01f1bf99a287167482f1cea2849c9b71",
        "question": [
          "What is revenue by customer segment and quarter?"
        ],
        "sql": [
          "SELECT\n",
          "  dc.segment,\n",
          "  dd.year,\n",
          "  dd.quarter,\n",
          "  SUM(fo.amount) AS revenue,\n",
          "  COUNT(DISTINCT fo.order_id) AS order_count\n",
          "FROM bootcamp_dev.dev_rahmani_taoufiq_sales.fact_orders fo\n",
          "JOIN bootcamp_dev.dev_rahmani_taoufiq_sales.dim_customer dc\n",
          "  ON fo.customer_id = dc.customer_id\n",
          "JOIN bootcamp_dev.dev_rahmani_taoufiq_sales.dim_date dd\n",
          "  ON fo.order_date = dd.date\n",
          "GROUP BY dc.segment, dd.year, dd.quarter\n",
          "ORDER BY dc.segment, dd.year, dd.quarter"
        ]
      },
      {
        "id": "01f1bf99bcf21fc4a249bf076d449ccd",
        "question": [
          "What is monthly revenue and order count by sales channel?"
        ],
        "sql": [
          "SELECT\n",
          "  `order_month`,\n",
          "  `channel`,\n",
          "  MEASURE(`revenue`) AS `revenue`,\n",
          "  MEASURE(`order_count`) AS `order_count`\n",
          "FROM bootcamp_dev.dev_rahmani_taoufiq_sales.orders_metrics\n",
          "GROUP BY ALL\n",
          "ORDER BY `order_month` ASC, `channel` ASC"
        ]
      }
    ],
